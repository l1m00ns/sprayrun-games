# Copy to .env and fill in.

# ---- FRONT-END (these two are read by the browser; baked in when you run `npm run build`) ----
# Address of the backend. EMPTY = the server that serves the page (npm start: one port for UI + API + WebSocket).
# Set it when the backend is hosted elsewhere, e.g. on Render:   NEXT_PUBLIC_BACKEND_URL=https://reverse-surfers-backend.onrender.com
# (a https page needs an https backend). To change it without rebuilding, edit public/config.js instead.
NEXT_PUBLIC_BACKEND_URL=
# Only if the WebSocket is not at <backend>/ws (rare).
NEXT_PUBLIC_WS_URL=

# ---- BACKEND (server only, never sent to the browser) ----
OPENROUTER_API_KEY=
TOKENHARBOR_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
# TOKENHARBOR_MODELS=deepseek-v4.1-flash:free,mimo-v2.6-flash:free
# ADMIN_KEY=
# DATA_DIR=./data
# PORT=3000
# The front-end's address(es) allowed to call the API and open /ws (comma separated). Empty = any site.
# CORS_ORIGIN=https://my-game.vercel.app
# TRUST_PROXY=1   # behind a reverse proxy / hosting platform
